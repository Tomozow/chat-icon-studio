{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "dialog + fs for open/save and dropped files",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "fs:default",
    {
      "identifier": "fs:allow-read-file",
      "allow": [{ "path": "**" }]
    },
    {
      "identifier": "fs:allow-write-file",
      "allow": [{ "path": "**" }]
    }
  ]
}
