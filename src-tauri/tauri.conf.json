{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Chat Icon Studio",
  "version": "0.1.0",
  "identifier": "studio.chaticon.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:4867",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Chat Icon Studio",
        "width": 1280,
        "height": 840,
        "minWidth": 500,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "fs": {
      "requireLiteralLeadingDot": false
    }
  }
}
